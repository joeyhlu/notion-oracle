{
  "name": "notion-oracle",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Notion AI on your own Claude or ChatGPT key, as a browser extension.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0"
  }
}
